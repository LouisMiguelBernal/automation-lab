# From https://dashboard.stripe.com/test/apikeys  (use the TEST key, sk_test_...)
STRIPE_SECRET_KEY=sk_test_xxx

# Printed by `stripe listen` (whsec_...). Different from the dashboard one.
STRIPE_WEBHOOK_SECRET=whsec_xxx

PORT=4242
PUBLIC_URL=http://localhost:4242

# Optional: n8n Webhook node URL to forward verified events to.
# Leave blank to skip forwarding.
N8N_WEBHOOK_URL=
